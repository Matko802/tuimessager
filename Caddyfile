# Caddy reverse proxy for tuimessager — 100% free automatic TLS via Let's Encrypt.
#
# Runs in the SAME container as tuimessager-server (see run.sh), proxying to
# it over loopback. Started only when TUIMESSAGER_DOMAIN is set; empty = LAN
# mode, server alone on :3000.
{
	storage file_system {
		root /data/caddy
	}
}

{$TUIMESSAGER_DOMAIN} {
	reverse_proxy 127.0.0.1:3000

	# Don't leak the backend version; small hardening header set.
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
}
